# Prevent script execution in uploads directory
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .asp

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|cgi|pl|py|asp|sh|bash)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(?i:jpe?g|png|gif|webp|svg|ico|pdf)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Allow from all
  </IfModule>
</FilesMatch>
